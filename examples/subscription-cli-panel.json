          "schema_version": 1,
          "kind": "claude",
          "autonomy": "inference_only",
          "executable": null,
          "working_directory": null,
          "max_stdout_bytes": 4194304,
          "max_stderr_bytes": 1048576,
          "max_events": 10000,
          "max_turns": 16,
          "profile_environment": ["HOME", "PATH", "USER", "LOGNAME", "USERPROFILE", "XDG_CONFIG_HOME"],
          "inherit_environment": false,
          "load_native_customizations": false
