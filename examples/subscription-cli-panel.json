      },
      "max_input_tokens": 32000,
      "max_output_tokens": 4096,
      "max_cost_microusd": 250000,
      "input_cost_microusd_per_million_tokens": 1,
      "output_cost_microusd_per_million_tokens": 1,
      "timeout_seconds": 60,
      "weight_millis": 1000
    },
    {
